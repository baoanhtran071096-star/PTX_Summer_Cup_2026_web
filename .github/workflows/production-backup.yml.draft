# ============================================================
# M14 — Automated production backup (DRAFT, NOT ACTIVE)
#
# This file uses a .yml.draft extension specifically so GitHub Actions
# does NOT pick it up (Actions only reads .yml/.yaml in this directory).
# It will not run until:
#   1. This repository exists on GitHub and is set to PRIVATE (required —
#      see docs/m14-backup-architecture.md: private repos get a 400-day
#      artifact retention ceiling, public repos are capped at 90 days).
#   2. SUPABASE_ACCESS_TOKEN is added to GitHub Secrets
#      (Settings > Secrets and variables > Actions).
#   3. This file is renamed to production-backup.yml and committed.
#
# No external storage account is needed — private GitHub Actions
# artifacts satisfy the locked retention policy on their own (verified
# against GitHub's own docs, see docs/m14-backup-architecture.md).
# ============================================================

name: Production Database Backup

on:
  schedule:
    # Daily at 02:00 UTC — adjust once the storage destination is chosen
    # and this workflow is actually enabled.
    - cron: '0 2 * * *'
  workflow_dispatch: {}

jobs:
  backup:
    name: Dump + verify + upload production backup
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: supabase/setup-cli@v1
        with:
          version: latest

      - name: Link to production (ref confirmed, never any other project)
        env:
          SUPABASE_ACCESS_TOKEN: ${{ secrets.SUPABASE_ACCESS_TOKEN }}
        run: |
          supabase link --project-ref tqdsvtuspehavhcygipf --yes
          LINKED=$(cat supabase/.temp/project-ref)
          if [ "$LINKED" != "tqdsvtuspehavhcygipf" ]; then
            echo "ABORT: linked ref ($LINKED) does not match the approved production ref"
            exit 1
          fi

      - name: Dump production database
        env:
          SUPABASE_ACCESS_TOKEN: ${{ secrets.SUPABASE_ACCESS_TOKEN }}
        run: |
          TIMESTAMP=$(date -u +"%Y%m%dT%H%M%SZ")
          echo "BACKUP_FILE=production-${TIMESTAMP}.sql" >> "$GITHUB_ENV"
          supabase db dump --linked -f "production-${TIMESTAMP}.sql"

      - name: Verify backup integrity (structural, not just "command exited 0")
        run: |
          set -e
          FILE="$BACKUP_FILE"
          test -s "$FILE" || { echo "ABORT: backup file is empty"; exit 1; }
          head -1 "$FILE" | grep -q "SET" || { echo "ABORT: unexpected file header, not a pg_dump output"; exit 1; }
          COUNT=$(grep -c "CREATE EXTENSION" "$FILE" || true)
          if [ "$COUNT" -lt 1 ]; then
            echo "ABORT: no CREATE EXTENSION statements found — dump looks incomplete"
            exit 1
          fi
          echo "Backup integrity check passed: $FILE ($COUNT extension statements found)"

      - name: Upload backup as a private GitHub Actions artifact
        uses: actions/upload-artifact@v4
        with:
          name: production-backup-${{ github.run_id }}
          path: ${{ env.BACKUP_FILE }}
          retention-days: 90
          # Artifacts are only downloadable by accounts with read access
          # to this repository — requires the repo to be PRIVATE (see
          # docs/m14-backup-architecture.md). A public repo would make
          # every backup, including production data, publicly downloadable.

      - name: Clean up local dump file (never leave it on the runner or commit it)
        if: always()
        run: rm -f "$BACKUP_FILE"
