# TUYỆT ĐỐI KHÔNG commit file ".env" thật lên Git — chỉ file .env.example
# (không chứa secret thật) mới nên được commit.

POSTGRES_USER=ptx_user
POSTGRES_PASSWORD=doi-mat-khau-nay-truoc-khi-deploy
POSTGRES_DB=ptx_summer_cup

# Chuỗi bí mật dùng để ký JWT token — PHẢI đổi sang chuỗi ngẫu nhiên dài,
# khó đoán trước khi deploy thật. Có thể tạo nhanh bằng lệnh:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=doi-chuoi-nay-thanh-chuoi-ngau-nhien-dai-truoc-khi-deploy
