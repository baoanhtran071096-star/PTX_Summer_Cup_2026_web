# ============================================================
# PTX Summer Cup 2026 — Biến môi trường mẫu
# ============================================================
# Copy file này thành ".env" (cùng thư mục) rồi điền giá trị THẬT vào.
# TUYỆT ĐỐI KHÔNG commit file ".env" thật lên Git — chỉ file .env.example
# (không chứa secret thật) mới nên được commit.

POSTGRES_USER=ptx_user
POSTGRES_PASSWORD=doi-mat-khau-nay-truoc-khi-deploy
POSTGRES_DB=ptx_summer_cup

# Chuỗi bí mật dùng để ký JWT token — PHẢI đổi sang chuỗi ngẫu nhiên dài,
# khó đoán trước khi deploy thật. Có thể tạo nhanh bằng lệnh:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=doi-chuoi-nay-thanh-chuoi-ngau-nhien-dai-truoc-khi-deploy

# ============================================================
# Target architecture (Next.js + Supabase) — used from M00 onward.
# The Postgres/JWT vars above are legacy/unused scaffolding
# (docs/legacy/r25-state-inventory.md §7) kept only for historical
# reference until the archive/docker-compose cleanup is approved.
# ============================================================

# Public — safe to expose to the browser (RLS is the real gate, not secrecy).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — NEVER exposed to the browser bundle. Bypasses RLS.
# Only used server-side for genuinely privileged system operations
# (docs/architecture §9) — never as the default admin CRUD path.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# AI Experience (M10) — optional. Provider-agnostic: any endpoint
# implementing the OpenAI chat-completions request/response shape.
# The app functions fully with these unset; only the AI assistant
# widget degrades to a "not configured" message (docs/architecture
# §15 — AI is a capability, never an architecture owner).
# ============================================================
AI_PROVIDER_API_KEY=your-ai-provider-api-key
AI_PROVIDER_API_URL=https://api.your-ai-provider.example/v1/chat/completions
AI_PROVIDER_MODEL=your-model-name
