rules_version = '2';

// ============================================================
// PTX Summer Cup 2026 — Firestore Security Rules
// ============================================================
// Cách dùng: vào Firebase Console > Firestore Database > tab "Rules",
// dán TOÀN BỘ nội dung file này vào, rồi bấm "Publish".
//
// Nguyên tắc:
//   - AI ĐỌC ĐƯỢC (public read): mọi người xem web đều cần đọc được tỷ số,
//     thống kê, thông tin sự kiện — không cần đăng nhập.
//   - CHỈ ADMIN ĐÃ ĐĂNG NHẬP MỚI GHI ĐƯỢC (write yêu cầu request.auth != null):
//     đây chính là lớp bảo mật thật sự — khác với hệ thống cũ chỉ kiểm tra
//     phía trình duyệt (ai mở DevTools cũng sửa được). Với luật này, Firebase
//     server sẽ tự chặn mọi request ghi nếu không có token đăng nhập hợp lệ,
//     bất kể người gọi có sửa code JS phía client thế nào.
//
// Nếu sau này có NHIỀU tài khoản Auth (vd: nhiều admin) mà muốn giới hạn chỉ
// một vài email cụ thể mới được ghi, có thể thay điều kiện write thành:
//   allow write: if request.auth != null &&
//                request.auth.token.email in ['admin1@ptxsummercup.internal', 'admin2@ptxsummercup.internal'];

service cloud.firestore {
  match /databases/{database}/documents {

    match /tournamentState/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ============================================================
    // BẢNG XẾP HẠNG DỰ ĐOÁN CỦA CĐV (predictions)
    // ============================================================
    // CĐV đăng nhập ẨN DANH (Anonymous Auth) chỉ để có một uid riêng. Tên tài liệu
    // CHÍNH LÀ uid đó, nên luật dưới đây cho phép mỗi người ghi đúng 1 phiếu của
    // mình — không mạo danh người khác, không spam nhiều phiếu, không xoá phiếu
    // của ai. Chỉ admin (tài khoản email/password, tức có token.email) mới được xoá.
    //
    // ⚠️ Cần bật "Anonymous" trong Firebase Console > Authentication > Sign-in method,
    //    nếu không CĐV sẽ không ghi được và trang tự động lùi về chế độ chỉ-máy-này.
    match /predictions/{uid} {
      allow read: if true;

      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.data.uid == uid
                            && request.resource.data.name is string
                            && request.resource.data.name.size() > 0
                            && request.resource.data.name.size() <= 40
                            && request.resource.data.keys().hasOnly(
                                 ['uid', 'name', 'scores', 'mvpId', 'goldenBootId', 'ticket', 'updatedAt']
                               );

      allow delete: if request.auth != null && request.auth.token.email != null;
    }

    // Mặc định: chặn tất cả những gì không khớp rule ở trên (an toàn theo kiểu "deny by default")
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
